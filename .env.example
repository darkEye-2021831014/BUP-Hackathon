# GridWise LLM-Assisted Energy Optimizer — environment variable template.
# Copy this file to .env and fill in your real values locally.
# DO NOT commit .env (it must contain your secret API keys).
#
# At least ONE of GROQ_API_KEY / GEMINI_API_KEY must be set; if neither
# is set, the service falls back to the deterministic regex interpreter
# (acceptable only for local testing, not as the primary interpreter in
# production per the rubric).

# ---- LLM provider configuration ----
# Primary LLM provider: "groq" or "gemini" (or "off" to force fallback).
LLM_PROVIDER=groq

# Free-tier API keys — get one of these (you do NOT need both):
#   Groq:    https://console.groq.com
#   Gemini:  https://ai.google.dev
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Per-attempt request timeout (seconds). Must be well under 30s.
LLM_TIMEOUT_S=12

# How many times to retry each provider before falling back.
LLM_MAX_RETRIES=1

# ---- HTTP server ----
PORT=8000
LOG_LEVEL=INFO
